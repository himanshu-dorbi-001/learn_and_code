{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "../frontend/**/*.ts"]
}
